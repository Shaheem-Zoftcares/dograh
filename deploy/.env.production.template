# ==============================================================================
# Dograh Production Environment Configuration Template
# ==============================================================================
# Copy this template to .env in your deployment directory:
#   cp deploy/.env.production.template .env
#
# IMPORTANT: Generate secure random values for all secrets using:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE HOST & REGISTRY CONFIGURATION
# ------------------------------------------------------------------------------
# Docker Hub organization or username where CI/CD pushes prebuilt images
# Used by docker-compose.override.yaml (e.g. myorg or johndoe)
DOCKERHUB_REPO=your-dockerhub-org-or-username

# Runtime environment (must be "production" for VPS deployments)
ENVIRONMENT=production

# Public IPv4 address of the VPS host (e.g. 203.0.113.50)
# Used by Coturn for external-ip and WebRTC ICE candidate reflection
SERVER_IP=203.0.113.50

# Public domain or hostname without protocol (e.g. voice.yourdomain.com or 203-0-113-50.sslip.io)
# Used by Nginx server_name and Coturn realm
PUBLIC_HOST=voice.yourdomain.com

# Public base URL including scheme (e.g. https://voice.yourdomain.com)
# Canonical origin for webhooks, CORS, and client redirection
PUBLIC_BASE_URL=https://voice.yourdomain.com

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# JWT secret for Open-Source Software (OSS) authentication tokens
# MANDATORY: Generate using `openssl rand -hex 32`
OSS_JWT_SECRET=replace_with_openssl_rand_hex_32

# PostgreSQL database password for the "postgres" user
# MANDATORY: Generate using `openssl rand -hex 32`
# NOTE: Baked into postgres_data volume on first database initialization.
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32

# Redis authentication password for worker broker and cache
# MANDATORY: Generate using `openssl rand -hex 32`
REDIS_PASSWORD=replace_with_openssl_rand_hex_32

# MinIO (S3-compatible object storage) administrative root credentials
MINIO_ROOT_USER=dograh_minio_admin
MINIO_ROOT_PASSWORD=replace_with_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 3. WEBRTC & TURN SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Enable coturn WebRTC STUN/TURN server (always true for remote deployments)
ENABLE_COTURN=true

# HMAC secret key for ephemeral WebRTC TURN REST API credentials
# MANDATORY: Generate using `openssl rand -hex 32`
TURN_SECRET=replace_with_openssl_rand_hex_32

# Force WebRTC clients to use TURN relay only (diagnostic use only; default: false)
FORCE_TURN_RELAY=false

# Override TURN host if coturn runs on a separate hostname from PUBLIC_HOST
# TURN_HOST=turn.yourdomain.com

# ------------------------------------------------------------------------------
# 4. PROCESS SCALING & TELEPHONY SERVICES
# ------------------------------------------------------------------------------
# Number of Uvicorn FastAPI workers load-balanced by Nginx (ports 8000..8000+N-1)
# Recommended: 2 for standard VPS (2-4 vCPUs)
FASTAPI_WORKERS=2

# Enable public user registration (set to false to restrict to admin invites)
ENABLE_SIGNUP=true

# Enable Asterisk ARI Telephony Manager process
ENABLE_ARI_MANAGER=true

# Enable outbound voice campaign background orchestration engine
ENABLE_CAMPAIGN_ORCHESTRATOR=true

# Secret for signing carrier WebSocket audio streaming capability URLs (optional)
TELEPHONY_WS_TOKEN_SECRET=
TELEPHONY_WS_TOKEN_ENFORCE=false

# Enable anonymous product telemetry (set to false to opt out)
ENABLE_TELEMETRY=true

# Make Langfuse execution traces publicly accessible (default: false)
LANGFUSE_TRACES_PUBLIC=false

# ------------------------------------------------------------------------------
# 5. OPTIONAL STORAGE OVERRIDES (AWS S3)
# ------------------------------------------------------------------------------
# Set ENABLE_AWS_S3=true to store voice audio recordings in AWS S3 instead of MinIO
ENABLE_AWS_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_SIGNATURE_VERSION=
S3_ADDRESSING_STYLE=

# ------------------------------------------------------------------------------
# 6. SPLIT DEPLOYMENT OVERRIDES (DERIVED IN-APP BY DEFAULT)
# ------------------------------------------------------------------------------
# Internal URL Next.js SSR uses to reach FastAPI container over Docker network
BACKEND_URL=http://api:8000

# Overrides for external public endpoints if separated from PUBLIC_BASE_URL
# BACKEND_API_ENDPOINT=https://api.yourdomain.com
# MINIO_PUBLIC_ENDPOINT=https://storage.yourdomain.com

# Cloudflare Named Tunnel Token (only used when running with --profile tunnel)
# CLOUDFLARE_TUNNEL_TOKEN=
